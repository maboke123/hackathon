# Postgres connection string. Leave empty for the in-memory database (resets on restart).
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The exact URL people open in the browser. Required in production.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Google AI Studio key for semantic search (gemini-embedding-001, free tier).
# Without it, search is keyword only.
GEMINI_API_KEY=